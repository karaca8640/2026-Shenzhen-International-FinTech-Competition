# Copy to .env at the repository root. No key is needed for the complete demo.
ENV=dev
LLM_PROVIDER=fake
DATABASE_URL=sqlite:///var/refundpath.db

# Optional external summarisation only: install backend/requirements-dev.txt,
# select a provider and add your own key. Both per-case consent and a summary
# request are mandatory. No model ever sets eligibility, money or deadlines.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=

# Full upstream regression tests / evaluation tools are retained separately.
# They do not handle RefundPath documents, and are not part of its runtime.
